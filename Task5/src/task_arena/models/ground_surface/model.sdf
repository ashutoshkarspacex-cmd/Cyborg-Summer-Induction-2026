<?xml version='1.0'?>
<sdf version='1.6'>

  <model name='ground_surface'>

    <static>true</static>

    <link name='link_0'>

      <pose>0 0 0 0 0 0</pose>

      <self_collide>false</self_collide>
      <enable_wind>false</enable_wind>
      <kinematic>false</kinematic>
      <gravity>true</gravity>

      <inertial>
        <mass>1.0</mass>

        <pose>0 0 0 0 0 0</pose>

        <inertia>
          <ixx>1.0</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>1.0</iyy>
          <iyz>0.0</iyz>
