<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="e_camera">
    <static>true</static>
    <link name="camera_1_link">
      <gravity>false</gravity>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.000166667</ixx>
          <iyy>0.000166667</iyy>
          <izz>0.000166667</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://e_camera/meshes/camera.dae</uri>
            <scale>0.03 0.03 0.03</scale>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://e_camera/meshes/camera.dae</uri>
            <scale>0.03 0.03 0.03</scale>
          </mesh>
        </geometry>
      </visual>


    <sensor name="camera" type="camera">

        <pose>0 0 0 1.57 1.57 1.57</pose>

        <visualize>true</visualize>

        <always_on>true</always_on>

        <update_rate>30</update_rate>

        <topic>camera</topic>

        <camera name="camera_1">

            <horizontal_fov>1.2</horizontal_fov>

            <image>
                <width>500</width>
                <height>500</height>
                <format>R8G8B8</format>
            </image>

            <clip>
                <near>0.2</near>
                <far>800</far>
            </clip>

        </camera>

    </sensor>



    </link>

  </model>

</sdf>
